---
import BaseLayout from '@layouts/BaseLayout.astro';
import Plate from '@198x-ui/components/Plate.astro';
---

<BaseLayout>
  <main>
    <Plate prefix="isa" project="isa" size={40} href="/" />
    <h1>Instruction encoding, written down once.</h1>
    <p class="lead">ISA198x is the executable instruction-set layer: encoding truth for every CPU the family touches, carrying primary citations, and shared by the assembler and the disassembler alike.</p>
    <p class="status">A layer inside Asm198x today. This site exists so it has somewhere to surface when it stands alone.</p>
    <footer>
      One of the <a href="https://github.com/isa198x">198x family</a>. The
      wordmark, palette and type come from <a href="https://github.com/stevehill1981/198x-ui">198x-ui</a>.
    </footer>
  </main>
</BaseLayout>
